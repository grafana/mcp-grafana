{
  "name": "@mcp-grafana/mcp-apps",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:apps",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build:apps": "vite build --config grafana.vite.config.ts",
    "build:preview": "vite build --config preview/vite.config.ts",
    "dev": "vite --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "echarts": "^6.1.0",
    "lucide-react": "^0.577.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@grafana/data": "13.2.2",
    "@grafana/ui": "13.2.2",
    "@grafana/viz-contract": "1.6.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "jsdom": "^31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-inlinesvg": "4.6.0",
    "semver": "7.8.6",
    "typescript": "~7.0.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ]
}
