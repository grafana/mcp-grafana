{
  "name": "@mcp-grafana/mcp-apps",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:apps",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build:trace": "vite build --config trace.vite.config.ts",
    "build:apps": "npm run build:trace",
    "build:preview": "vite build --config preview/vite.config.ts",
    "dev": "vite --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "lucide-react": "^0.577.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "^30.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ]
}
