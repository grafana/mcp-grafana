{
  "description": "Golden cases for lokiguard.Assess. Every implementation of the guard (Go here, the Assistant plugin's TypeScript port) must produce these verdicts. windowSeconds is the range-query window ending at a fixed end time; 0 means no bounds. stats.bytes answers every selector; stats.bySelector overrides per selector; stats.error makes every call that has no bySelector entry fail. policy.estimateAlways runs the byte estimate for every query, including ones a static check already blocked.",
  "cases": [
    {"name": "catch-all plus regex", "logql": "{job=~\".+\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["selector"]}},
    {"name": "catch-all star regex", "logql": "{cluster=~\".*\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["selector"]}},
    {"name": "empty selector", "logql": "{}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["selector"]}},
    {"name": "negative-only selector", "logql": "{app!=\"x\", job!~\"y.*\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["selector"]}},
    {"name": "catch-all with an equality is selective", "logql": "{cluster=~\".+\", namespace=\"foo\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "allow"}},
    {"name": "selective regex", "logql": "{app=~\"api-.*\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "allow"}},
    {"name": "catch-all on one side of a binary expression", "logql": "sum(rate({app=\"x\"}[5m])) / sum(rate({cluster=~\".+\"}[5m]))", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["selector"]}},
    {"name": "commented-out catch-all is ignored", "logql": "{app=\"x\"} # see {cluster=~\".+\"} for all", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "allow"}},
    {"name": "block comment cannot hide a catch-all", "logql": "{cluster/*x*/=~\".+\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["selector"]}},
    {"name": "unparseable selector", "logql": "{app==\"x\"}", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "unknown", "cause": "unparseable"}},
    {"name": "unparseable selector still hits the range cap", "logql": "{app==\"x\"}", "windowSeconds": 172800, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["range"]}},
    {"name": "no selector", "logql": "foo", "windowSeconds": 3600, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "unknown", "cause": "unparseable"}},

    {"name": "window over the cap", "logql": "{namespace=\"foo\", app=\"bar\"}", "windowSeconds": 172800, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["range"]}},
    {"name": "window exactly at the cap", "logql": "{namespace=\"foo\"}", "windowSeconds": 86400, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "allow"}},
    {"name": "range vector adds to the window", "logql": "rate({namespace=\"foo\"}[20h])", "windowSeconds": 28800, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["range"]}},
    {"name": "instant query sized by its range vector", "logql": "sum(count_over_time({namespace=\"foo\"}[30d]))", "instant": true, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["range"]}},
    {"name": "small instant range vector", "logql": "sum(count_over_time({namespace=\"foo\"}[1h]))", "instant": true, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "allow"}},
    {"name": "fractional range vector", "logql": "sum(count_over_time({namespace=\"foo\"}[720.5h]))", "instant": true, "policy": {"maxRangeSeconds": 86400}, "expect": {"verdict": "block", "kinds": ["range"]}},
    {"name": "no range cap configured", "logql": "{namespace=\"foo\"}", "windowSeconds": 31536000, "policy": {}, "expect": {"verdict": "allow"}},

    {"name": "over the byte budget", "logql": "{namespace=\"foo\", app=\"bar\"} |= \"error\"", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 214748364800}, "expect": {"verdict": "block", "kinds": ["bytes"], "estimatedBytes": 214748364800, "statsCalls": 1}},
    {"name": "under the byte budget", "logql": "{namespace=\"foo\", app=\"bar\"}", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 1073741824}, "expect": {"verdict": "allow", "estimatedBytes": 1073741824, "statsCalls": 1}},
    {"name": "exactly at the byte budget is allowed", "logql": "{namespace=\"foo\"}", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 107374182400}, "expect": {"verdict": "allow", "estimatedBytes": 107374182400, "statsCalls": 1}},
    {"name": "binary expression sums both legs", "logql": "sum(rate({namespace=\"a\", app=\"x\"}[5m])) / sum(rate({namespace=\"a\", app=\"y\"}[5m]))", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 64424509440}, "expect": {"verdict": "block", "kinds": ["bytes"], "estimatedBytes": 128849018880, "statsCalls": 2}},
    {"name": "repeated selector fetched once, counted twice", "logql": "sum(rate({namespace=\"a\", app=\"x\"}[5m])) / sum(rate({namespace=\"a\", app=\"x\"}[10m]))", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 64424509440}, "expect": {"verdict": "block", "kinds": ["bytes"], "estimatedBytes": 128849018880, "statsCalls": 1}},
    {"name": "byte check skipped for an instant log query with no window", "logql": "{namespace=\"foo\"}", "instant": true, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 214748364800}, "expect": {"verdict": "allow", "statsCalls": 0}},
    {"name": "stats skipped when the selector already blocks", "logql": "{cluster=~\".+\"}", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bytes": 0}, "expect": {"verdict": "block", "kinds": ["selector"], "statsCalls": 0}},
    {"name": "stats skipped when the range already blocks", "logql": "{namespace=\"foo\"}", "windowSeconds": 172800, "policy": {"maxBytes": 107374182400, "maxRangeSeconds": 86400}, "stats": {"bytes": 0}, "expect": {"verdict": "block", "kinds": ["range"], "statsCalls": 0}},
    {"name": "estimate failure is unknown", "logql": "{namespace=\"foo\", app=\"bar\"}", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"error": true}, "expect": {"verdict": "unknown", "cause": "estimate_failed", "statsCalls": 1}},
    {"name": "partial total already over budget still blocks", "logql": "sum(rate({namespace=\"a\", app=\"x\"}[5m])) / sum(rate({namespace=\"a\", app=\"y\"}[5m]))", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bySelector": {"{namespace=\"a\", app=\"x\"}": 536870912000}, "error": true}, "expect": {"verdict": "block", "kinds": ["bytes"], "estimatedBytes": 536870912000, "statsCalls": 2}},
    {"name": "partial total under budget is unknown", "logql": "sum(rate({namespace=\"a\", app=\"x\"}[5m])) / sum(rate({namespace=\"a\", app=\"y\"}[5m]))", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400}, "stats": {"bySelector": {"{namespace=\"a\", app=\"x\"}": 1073741824}, "error": true}, "expect": {"verdict": "unknown", "cause": "estimate_failed", "statsCalls": 2}},

    {"name": "estimateAlways sizes a statically blocked query", "logql": "{job=~\".+\"}", "windowSeconds": 3600, "policy": {"estimateAlways": true}, "stats": {"bytes": 214748364800}, "expect": {"verdict": "block", "kinds": ["selector"], "estimatedBytes": 214748364800, "statsCalls": 1}},
    {"name": "estimateAlways with a budget adds the bytes reason to a static block", "logql": "{job=~\".+\"}", "windowSeconds": 3600, "policy": {"maxBytes": 107374182400, "estimateAlways": true}, "stats": {"bytes": 214748364800}, "expect": {"verdict": "block", "kinds": ["selector", "bytes"], "estimatedBytes": 214748364800, "statsCalls": 1}},
    {"name": "estimateAlways failure cannot downgrade a static block", "logql": "{job=~\".+\"}", "windowSeconds": 3600, "policy": {"estimateAlways": true}, "stats": {"error": true}, "expect": {"verdict": "block", "kinds": ["selector"], "statsCalls": 1}},
    {"name": "estimateAlways without a budget allows a selective query", "logql": "{namespace=\"foo\"}", "windowSeconds": 3600, "policy": {"estimateAlways": true}, "stats": {"bytes": 1073741824}, "expect": {"verdict": "allow", "estimatedBytes": 1073741824, "statsCalls": 1}},
    {"name": "estimateAlways without a budget ignores a stats failure", "logql": "{namespace=\"foo\"}", "windowSeconds": 3600, "policy": {"estimateAlways": true}, "stats": {"error": true}, "expect": {"verdict": "allow", "statsCalls": 1}}
  ]
}
