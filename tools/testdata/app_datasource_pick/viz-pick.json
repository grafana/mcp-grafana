{
  "pickVersion": 1,
  "rules": [
    {
      "id": "node-graph",
      "reason": "A frame has the preferred visualization type nodeGraph.",
      "when": { "hasPreferredVisualisationType.nodeGraph": true },
      "type": "grafana-relations-panel",
      "options": { "seriesType": "graph" },
      "fieldConfig": {}
    },
    {
      "id": "heatmap-cells",
      "reason": "A frame has the data frame type heatmap-cells.",
      "when": { "hasDataFrameType.heatmap-cells": true },
      "type": "grafana-echartsheatmap-panel",
      "options": {},
      "fieldConfig": {}
    },
    {
      "id": "time-series",
      "reason": "The frames have a time field with more than one instant and a number field.",
      "when": { "hasFieldType.time": true, "hasFieldType.number": true, "isInstant": false },
      "type": "grafana-echartscartesian-panel",
      "options": { "seriesType": "line" },
      "fieldConfig": {}
    },
    {
      "id": "few-parts",
      "reason": "The frames have one string field, one number field and 2 to 10 rows.",
      "when": {
        "hasFieldType.time": false,
        "fieldCountByType.string": 1,
        "fieldCountByType.number": 1,
        "rowCountTotal": { "min": 2, "max": 10 }
      },
      "type": "grafana-echartsparttowhole-panel",
      "options": { "seriesType": "pie" },
      "fieldConfig": {}
    },
    {
      "id": "categories",
      "reason": "The frames have a string field and a number field, and no time field.",
      "when": { "hasFieldType.time": false, "hasFieldType.string": true, "hasFieldType.number": true },
      "type": "grafana-echartscartesian-panel",
      "options": { "seriesType": "bar" },
      "fieldConfig": {}
    },
    {
      "id": "default",
      "reason": "No other rule matches.",
      "when": {},
      "type": "grafana-echartscartesian-panel",
      "options": { "seriesType": "Auto" },
      "fieldConfig": {}
    }
  ]
}
