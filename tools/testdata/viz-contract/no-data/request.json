  "from": "now-24h",
  "to": "now",
  "queries": [
    {
      "refId": "A",
      "expr": "sum by (handler) (rate(missing_metric_total[5m]))",
      "legendFormat": "{{handler}}",
      "format": "time_series",
      "datasource": {
        "uid": "lgtm-prometheus"
      },
      "maxDataPoints": 1000,
      "intervalMs": 86400
    }
  ]
}
