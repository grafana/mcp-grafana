# Copy to .env and fill in to use live Grafana data (sample data is used otherwise).
# .env is gitignored — never commit real credentials.

# Your Grafana base URL (OSS instance or a Grafana Cloud stack).
GRAFANA_URL=https://your-stack.grafana.net

# A service-account token (Viewer is enough for read-only panels).
# The rule-fix "apply" action additionally needs alerting provisioning write.
GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Datasource UIDs.
GRAFANA_PROM_DS_UID=grafanacloud-prom
GRAFANA_LOKI_DS_UID=grafanacloud-logs

# Optional.
# GRAFANA_ORG_ID=1
